{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credits.schema.json",
  "title": "Credits",
  "description": "Published credits keyed by creditId. Research evidence stays out of runtime files.",
  "type": "object",
  "required": ["schemaVersion", "credits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "credits": {
      "type": "object",
      "propertyNames": { "$ref": "defs.schema.json#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["display", "sourceUrl", "usageTerms"],
        "properties": {
          "display": { "type": "string", "minLength": 1 },
          "sourceUrl": { "oneOf": [{ "type": "string", "pattern": "^https?://" }, { "type": "null" }] },
          "usageTerms": { "type": "string", "minLength": 1, "description": "Stated terms, or \"unknown\"." }
        }
      }
    }
  }
}
