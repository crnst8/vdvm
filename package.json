{
  "name": "vdvm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run catalog:build -- --mode fixture && vite --mode fixture",
    "dev:full": "npm run catalog:build -- --mode full && vite",
    "build": "npm run catalog:build -- --mode fixture && tsc -p . && vite build --mode fixture",
    "build:pages": "tsc -p . && vite build --mode pages --outDir dist-pages",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check": "npm run catalog:build -- --mode fixture && npm run catalog:validate -- --mode fixture && npm run typecheck && npm run test && vite build --mode fixture",
    "catalog:types": "tsx scripts/catalog/gen-types.ts",
    "catalog:build": "tsx scripts/catalog/build.ts",
    "catalog:folder": "tsx scripts/catalog/from-folder.ts",
    "catalog:validate": "tsx scripts/catalog/validate.ts",
    "catalog:prepare": "npm run catalog:build -- --mode full && npm run catalog:validate -- --mode full",
    "deploy:status": "bash deploy/sync.sh status",
    "deploy:sync": "bash deploy/sync.sh push",
    "plugin:ui": "node plugin/scripts/build-ui.mjs",
    "plugin:shared": "tsx plugin/scripts/gen-shared.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
